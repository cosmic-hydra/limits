uses stdin;
fn read_strs() -> [str] {
  let n = int(input_line());
  let out: [str] = [];
  for i in 0..n { push(out, input_line()); }
  return out;
}
fn show_strs(xs: [str]) {
  print(len(xs));
  for x in xs { print(x); }
}

fn main() {
  let xs = read_strs();
  let s = input_line();
  let out: [str] = [];
  for x in xs {
    if s == "" or len(split(x, s)) > 1 { push(out, x); }
  }
  show_strs(out);
}
