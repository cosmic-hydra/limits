uses stdin;
fn read_ints(line: str) -> [int] {
  let xs: [int] = [];
  if line == "" { return xs; }
  for p in split(line, " ") { push(xs, int(p)); }
  return xs;
}
fn fmt(xs: [int]) -> str {
  let ps: [str] = [];
  for x in xs { push(ps, str(x)); }
  return join(ps, " ");
}
fn main() { let n = int(input_line()); let f = [0, 0, 2, 0]; if n < 4 { print(f[n]); return; } for i in 4..n+1 { push(f, f[i-1] + f[i-2] + f[i-3] + f[i-4]); } print(f[n]); }
