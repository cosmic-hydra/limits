uses stdin;
fn is_pal(cs: [str], a: int) -> bool {
  let i = a;
  let j = len(cs) - 1;
  while i < j {
    if cs[i] != cs[j] { return false; }
    i = i + 1;
    j = j - 1;
  }
  return true;
}
fn main() {
  let s = input_line();
  let cs = split(s, "");
  if s == "" { print(""); return; }
  let i = 0;
  while not is_pal(cs, i) { i = i + 1; }
  let parts: [str] = [s];
  let k = i - 1;
  while k >= 0 { push(parts, cs[k]); k = k - 1; }
  print(join(parts, ""));
}
