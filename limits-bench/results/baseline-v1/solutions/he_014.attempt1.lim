uses stdin;
fn read_strs() -> [str] {
  let n = int(input_line());
  let out: [str] = [];
  for i in 0..n { push(out, input_line()); }
  return out;
}
fn show_strs(xs: [str]) {
  print(len(xs));
  for x in xs { print(x); }
}

fn main() {
  let cs = split(input_line(), "");
  let out: [str] = [];
  let cur = "";
  for c in cs {
    if c != "" { cur = cur + c; push(out, cur); }
  }
  show_strs(out);
}
