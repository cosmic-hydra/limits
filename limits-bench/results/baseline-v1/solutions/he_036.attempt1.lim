uses stdin;
fn read_ints(line: str) -> [int] {
  let xs: [int] = [];
  if line == "" { return xs; }
  for p in split(line, " ") { push(xs, int(p)); }
  return xs;
}
fn fmt(xs: [int]) -> str {
  let ps: [str] = [];
  for x in xs { push(ps, str(x)); }
  return join(ps, " ");
}
fn main() { let n = int(input_line()); let c = 0; for i in 0..n { if i % 11 == 0 or i % 13 == 0 { for ch in split(str(i), "") { if ch == "7" { c = c + 1; } } } } print(c); }
