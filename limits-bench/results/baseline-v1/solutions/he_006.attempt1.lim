uses stdin;
fn read_ints() -> [int] {
  let line = input_line();
  let out: [int] = [];
  if line == "" { return out; }
  for p in split(line, " ") { if p != "" { push(out, int(p)); } }
  return out;
}
fn show_ints(xs: [int]) {
  let parts: [str] = [];
  for x in xs { push(parts, str(x)); }
  print(join(parts, " "));
}

fn main() {
  let out: [int] = [];
  for g in split(input_line(), " ") {
    if g != "" {
      let d = 0;
      let m = 0;
      for c in split(g, "") {
        if c == "(" { d = d + 1; if d > m { m = d; } }
        else if c == ")" { d = d - 1; }
      }
      push(out, m);
    }
  }
  show_ints(out);
}
