uses stdin;
fn read_ints(line: str) -> [int] {
  let xs: [int] = [];
  if line == "" { return xs; }
  for p in split(line, " ") { push(xs, int(p)); }
  return xs;
}
fn fmt(xs: [int]) -> str {
  let ps: [str] = [];
  for x in xs { push(ps, str(x)); }
  return join(ps, " ");
}
fn main() { let xs = read_ints(input_line()); let m = xs[0]; for x in xs { if x > m { m = x; } } print(m); }
