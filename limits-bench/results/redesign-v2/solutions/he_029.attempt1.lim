uses stdin
fn starts(s: str, p: str) -> bool:
    let a = split(s, "")
    let b = split(p, "")
    if len(b) > len(a): return false
    for i in 0..len(b):
        if a[i] != b[i]: return false
    true
let n = unwrap(parse_int(env.stdin.read_line()))
var xs: [str] = []
for i in 0..n: push(xs, env.stdin.read_line())
let p = env.stdin.read_line()
let r = [x for x in xs if starts(x, p)]
print(len(r))
for x in r: print(x)
