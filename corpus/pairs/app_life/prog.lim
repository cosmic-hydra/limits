# Run Conway's Game of Life on the grid from stdin ("N" generations on the first line, then rows of . and #).
uses stdin

fn neighbours(g: [[str]], y: int, x: int) -> int:
    var c = 0
    for dy in -1..2:
        for dx in -1..2:
            let yy = y + dy
            let xx = x + dx
            if (dy != 0 or dx != 0) and yy >= 0 and yy < len(g) and xx >= 0 and xx < len(g[0]):
                if g[yy][xx] == "#": c += 1
    c

fn step(g: [[str]]) -> [[str]]:
    var n = g
    for y in 0..len(g):
        for x in 0..len(g[0]):
            let c = neighbours(g, y, x)
            if c == 3 or (c == 2 and g[y][x] == "#"):
                n[y][x] = "#"
            else:
                n[y][x] = "."
    n

let gens = int(env.stdin.read_line())
var g: [[str]] = []
var line = env.stdin.read_line()
while line != "":
    push(g, split(line, ""))
    line = env.stdin.read_line()
for i in 0..gens:
    g = step(g)
var alive = 0
for r in g:
    print(join(r, ""))
    alive += len([c for c in r if c == "#"])
print("alive", alive)
