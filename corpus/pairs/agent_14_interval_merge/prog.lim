# Merge overlapping intervals.
fn rnd(s: inout [int]) -> int:
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648
    s[0] / 65536

var seed = [37]
var keys: [int] = []
for i in 0..200000:
    let start = rnd(&seed) * 300
    push(keys, start * 1000 + rnd(&seed) % 1000)
sort(keys)
var merged = 0
var covered = 0
var longest = 0
var cs = -1
var ce = -1
for k in keys:
    let s = k / 1000
    let e = s + k % 1000
    if cs >= 0 and s <= ce:
        ce = max(ce, e)
    else:
        if cs >= 0:
            merged += 1
            covered += ce - cs
            longest = max(longest, ce - cs)
        cs = s
        ce = e
merged += 1
covered += ce - cs
longest = max(longest, ce - cs)
print(merged, covered, longest)
