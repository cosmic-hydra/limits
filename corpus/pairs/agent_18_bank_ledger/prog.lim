# Bank ledger simulation with overdraft rejection.
struct Account:
    id: int
    balance: int

fn rnd(s: inout [int]) -> int:
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648
    s[0] / 65536

var seed = [43]
var accts = [Account { id: i, balance: 1000 } for i in 0..10]
var rejected = 0
for t in 0..300000:
    let kind = rnd(&seed) % 3
    let a = rnd(&seed) % 10
    let b = rnd(&seed) % 10
    let amt = rnd(&seed) % 500
    if kind == 0:
        accts[a].balance += amt
    elif accts[a].balance < amt or (kind == 2 and a == b):
        rejected += 1
    else:
        accts[a].balance -= amt
        if kind == 2:
            accts[b].balance += amt
print([a.balance for a in accts], rejected)
