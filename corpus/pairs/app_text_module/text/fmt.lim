# String padding helpers.
pub fn repeat(s: str, n: int) -> str:
    var out = ""
    for i in 0..n:
        out += s
    out

pub fn pad_right(s: str, w: int) -> str:
    s + repeat(" ", w - len(s))

pub fn pad_left(s: str, w: int) -> str:
    repeat(" ", w - len(s)) + s

pub fn rule(w: int) -> str:
    repeat("-", w)
