# Same affordable-action selection as examples/agent_task.lim, using one guard.
let budget = 10;
let actions = [
    {"name": "search", "cost": 3, "value": 5},
    {"name": "browse", "cost": 12, "value": 9},
    {"name": "summarize", "cost": 2, "value": 4},
];
let best = nil;
for a in actions {
    if not (a["cost"] > budget) and (best == nil or a["value"] > best["value"]) {
        best = a;
    }
}
assert(best != nil, "no affordable action");
print("chosen:", best["name"]);
