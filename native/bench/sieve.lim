fn main() {
    let n = 10000000;
    let is: [bool] = [];
    for i in 0..n + 1 { push(is, true); }
    let count = 0;
    for i in 2..n + 1 {
        if is[i] {
            count = count + 1;
            let j = i * i;
            while j <= n {
                is[j] = false;
                j = j + i;
            }
        }
    }
    print(count);
}
