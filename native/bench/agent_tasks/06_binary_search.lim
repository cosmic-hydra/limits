# Binary search: lower-bound lookups into a sorted list.
fn rnd(s: inout [int]) -> int:
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648
    s[0] / 65536

fn lower_bound(xs: [int], x: int) -> int:
    var lo = 0
    var hi = len(xs)
    while lo < hi:
        let mid = (lo + hi) / 2
        if xs[mid] < x:
            lo = mid + 1
        else:
            hi = mid
    lo

var seed = [9]
var xs: [int] = []
var v = 0
for i in 0..200000:
    v += 1 + rnd(&seed) % 5
    push(xs, v)
var found = 0
var possum = 0
for i in 0..200000:
    let q = rnd(&seed) % (v + 1)
    let p = lower_bound(xs, q)
    possum += p
    if p < len(xs) and xs[p] == q:
        found += 1
print(found, possum)
