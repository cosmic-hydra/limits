# Top 10 largest values, descending.
fn rnd(s: [int]) -> int {
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648;
    return s[0] / 65536;
}

fn msort(a: [int]) {
    let n = len(a);
    let b: [int] = [];
    for i in 0..n {
        push(b, 0);
    }
    let w = 1;
    while w < n {
        let lo = 0;
        while lo < n {
            let mid = lo + w;
            if mid > n {
                mid = n;
            }
            let hi = lo + 2 * w;
            if hi > n {
                hi = n;
            }
            let i = lo;
            let j = mid;
            for k in lo..hi {
                if j >= hi or (i < mid and a[i] <= a[j]) {
                    b[k] = a[i];
                    i = i + 1;
                } else {
                    b[k] = a[j];
                    j = j + 1;
                }
            }
            lo = hi;
        }
        for t in 0..n {
            a[t] = b[t];
        }
        w = w * 2;
    }
}

fn main() {
    let seed = [23];
    let xs: [int] = [];
    for i in 0..300000 {
        let hi = rnd(seed);
        push(xs, hi * 32768 + rnd(seed));
    }
    msort(xs);
    let top: [int] = [];
    for i in 0..10 {
        push(top, xs[len(xs) - 1 - i]);
    }
    print(top);
}
