# Dedupe and sort a list of ints.
fn rnd(s: inout [int]) -> int:
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648
    s[0] / 65536

fn msort(a: inout [int]):
    let n = len(a)
    var b: [int] = []
    for i in 0..n:
        push(b, 0)
    var w = 1
    while w < n:
        var lo = 0
        while lo < n:
            var mid = lo + w
            if mid > n:
                mid = n
            var hi = lo + 2 * w
            if hi > n:
                hi = n
            var i = lo
            var j = mid
            for k in lo..hi:
                if j >= hi or (i < mid and a[i] <= a[j]):
                    b[k] = a[i]
                    i += 1
                else:
                    b[k] = a[j]
                    j += 1
            lo = hi
        for t in 0..n:
            a[t] = b[t]
        w *= 2

var seed = [3]
var xs: [int] = []
for i in 0..300000:
    push(xs, rnd(&seed) % 100000)
msort(&xs)
var u: [int] = []
for x in xs:
    if len(u) == 0 or u[len(u) - 1] != x:
        push(u, x)
var s = 0
for x in u:
    s += x
print(len(u), u[0], u[1], u[2], u[len(u) - 1], s)
