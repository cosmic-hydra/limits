# Merge overlapping intervals.
fn rnd(s: inout [int]) -> int:
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648
    s[0] / 65536

fn msort(a: inout [int]):
    let n = len(a)
    var b: [int] = []
    for i in 0..n:
        push(b, 0)
    var w = 1
    while w < n:
        var lo = 0
        while lo < n:
            var mid = lo + w
            if mid > n:
                mid = n
            var hi = lo + 2 * w
            if hi > n:
                hi = n
            var i = lo
            var j = mid
            for k in lo..hi:
                if j >= hi or (i < mid and a[i] <= a[j]):
                    b[k] = a[i]
                    i += 1
                else:
                    b[k] = a[j]
                    j += 1
            lo = hi
        for t in 0..n:
            a[t] = b[t]
        w *= 2

var seed = [37]
var keys: [int] = []
for i in 0..200000:
    let start = rnd(&seed) * 300
    push(keys, start * 1000 + rnd(&seed) % 1000)
msort(&keys)
var merged = 0
var covered = 0
var longest = 0
var cs = -1
var ce = -1
for k in keys:
    let s = k / 1000
    let e = s + k % 1000
    if cs >= 0 and s <= ce:
        if e > ce:
            ce = e
    else:
        if cs >= 0:
            merged += 1
            covered = covered + ce - cs
            if ce - cs > longest:
                longest = ce - cs
        cs = s
        ce = e
merged += 1
covered = covered + ce - cs
if ce - cs > longest:
    longest = ce - cs
print(merged, covered, longest)
