# Merge overlapping intervals.
fn rnd(s: [int]) -> int {
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648;
    return s[0] / 65536;
}

fn msort(a: [int]) {
    let n = len(a);
    let b: [int] = [];
    for i in 0..n {
        push(b, 0);
    }
    let w = 1;
    while w < n {
        let lo = 0;
        while lo < n {
            let mid = lo + w;
            if mid > n {
                mid = n;
            }
            let hi = lo + 2 * w;
            if hi > n {
                hi = n;
            }
            let i = lo;
            let j = mid;
            for k in lo..hi {
                if j >= hi or (i < mid and a[i] <= a[j]) {
                    b[k] = a[i];
                    i = i + 1;
                } else {
                    b[k] = a[j];
                    j = j + 1;
                }
            }
            lo = hi;
        }
        for t in 0..n {
            a[t] = b[t];
        }
        w = w * 2;
    }
}

fn main() {
    let seed = [37];
    let keys: [int] = [];
    for i in 0..200000 {
        let start = rnd(seed) * 300;
        push(keys, start * 1000 + rnd(seed) % 1000);
    }
    msort(keys);
    let merged = 0;
    let covered = 0;
    let longest = 0;
    let cs = -1;
    let ce = -1;
    for k in keys {
        let s = k / 1000;
        let e = s + k % 1000;
        if cs >= 0 and s <= ce {
            if e > ce {
                ce = e;
            }
        } else {
            if cs >= 0 {
                merged = merged + 1;
                covered = covered + ce - cs;
                if ce - cs > longest {
                    longest = ce - cs;
                }
            }
            cs = s;
            ce = e;
        }
    }
    merged = merged + 1;
    covered = covered + ce - cs;
    if ce - cs > longest {
        longest = ce - cs;
    }
    print(merged, covered, longest);
}
