# Bank ledger simulation with overdraft rejection.
struct Account { id: int, balance: int }

fn rnd(s: [int]) -> int {
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648;
    return s[0] / 65536;
}

fn main() {
    let seed = [43];
    let accts: [Account] = [];
    for i in 0..10 {
        push(accts, Account { id: i, balance: 1000 });
    }
    let rejected = 0;
    for t in 0..300000 {
        let kind = rnd(seed) % 3;
        let a = accts[rnd(seed) % 10];
        let b = accts[rnd(seed) % 10];
        let amt = rnd(seed) % 500;
        if kind == 0 {
            a.balance = a.balance + amt;
        } else if a.balance < amt or (kind == 2 and a.id == b.id) {
            rejected = rejected + 1;
        } else {
            a.balance = a.balance - amt;
            if kind == 2 {
                b.balance = b.balance + amt;
            }
        }
    }
    let bals: [int] = [];
    for a in accts {
        push(bals, a.balance);
    }
    print(bals, rejected);
}
