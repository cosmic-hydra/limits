# Format records as JSON-like lines.
struct Item { id: int, name: str, score: int, tags: [str] }

fn rnd(s: [int]) -> int {
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648;
    return s[0] / 65536;
}

fn fmt(it: Item) -> str {
    let ts: [str] = [];
    for t in it.tags {
        push(ts, "\"" + t + "\"");
    }
    return "{\"id\": " + str(it.id) + ", \"name\": \"" + it.name + "\", \"score\": " + str(it.score) + ", \"tags\": [" + join(ts, ", ") + "]}";
}

fn main() {
    let colors = ["red", "green", "blue", "gold"];
    let seed = [5];
    let lines: [str] = [];
    for i in 0..60000 {
        let it = Item { id: i, name: "n" + str(rnd(seed) % 1000), score: 0, tags: [] };
        it.score = rnd(seed) % 100;
        let k = rnd(seed) % 4;
        for j in 0..k {
            push(it.tags, colors[rnd(seed) % 4]);
        }
        push(lines, fmt(it));
    }
    let out = join(lines, "\n");
    print(lines[0]);
    print(lines[1]);
    print(len(out));
}
