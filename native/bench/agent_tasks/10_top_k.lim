# Top 10 largest values, descending.
fn rnd(s: [int]) -> int {
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648;
    return s[0] / 65536;
}

fn main() {
    let seed = [23];
    let xs: [int] = [];
    for i in 0..300000 {
        let hi = rnd(seed);
        push(xs, hi * 32768 + rnd(seed));
    }
    sort(xs);
    let top: [int] = [];
    for i in 0..10 {
        push(top, xs[len(xs) - 1 - i]);
    }
    print(top);
}
