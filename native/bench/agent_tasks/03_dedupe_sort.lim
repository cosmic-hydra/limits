# Dedupe and sort a list of ints.
fn rnd(s: [int]) -> int {
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648;
    return s[0] / 65536;
}

fn main() {
    let seed = [3];
    let xs: [int] = [];
    for i in 0..300000 {
        push(xs, rnd(seed) % 100000);
    }
    sort(xs);
    let u: [int] = [];
    for x in xs {
        if len(u) == 0 or u[len(u) - 1] != x {
            push(u, x);
        }
    }
    let s = 0;
    for x in u {
        s = s + x;
    }
    print(len(u), u[0], u[1], u[2], u[len(u) - 1], s);
}
