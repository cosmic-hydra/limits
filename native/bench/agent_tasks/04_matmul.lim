# Integer matrix multiply.
fn rnd(s: inout [int]) -> int:
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648
    s[0] / 65536

fn rand_matrix(n: int, seed: inout [int]) -> [[int]]:
    [[rnd(&seed) % 10 for j in 0..n] for i in 0..n]

let n = 150
var seed = [11]
let a = rand_matrix(n, &seed)
let b = rand_matrix(n, &seed)
var trace = 0
var total = 0
for i in 0..n:
    for j in 0..n:
        let s = sum([a[i][k] * b[k][j] for k in 0..n])
        total += s
        if i == j:
            trace += s
print(trace, total)
