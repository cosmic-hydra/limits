# Sum of Levenshtein distances over random word pairs.
fn rnd(s: [int]) -> int {
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648;
    return s[0] / 65536;
}

fn word(seed: [int]) -> str {
    let alpha = ["a", "b", "c", "d", "e", "f"];
    let cs: [str] = [];
    for i in 0..10 + rnd(seed) % 21 {
        push(cs, alpha[rnd(seed) % 6]);
    }
    return join(cs, "");
}

fn lev(s: str, t: str) -> int {
    let a = split(s, "");
    let b = split(t, "");
    let prev: [int] = [];
    for j in 0..len(b) + 1 {
        push(prev, j);
    }
    for i in 1..len(a) + 1 {
        let cur = [i];
        for j in 1..len(b) + 1 {
            let cost = 1;
            if a[i - 1] == b[j - 1] {
                cost = 0;
            }
            let best = prev[j - 1] + cost;
            if prev[j] + 1 < best {
                best = prev[j] + 1;
            }
            if cur[j - 1] + 1 < best {
                best = cur[j - 1] + 1;
            }
            push(cur, best);
        }
        prev = cur;
    }
    return prev[len(b)];
}

fn main() {
    let seed = [31];
    let total = 0;
    for i in 0..1500 {
        let s = word(seed);
        let t = word(seed);
        total = total + lev(s, t);
    }
    print(total);
}
