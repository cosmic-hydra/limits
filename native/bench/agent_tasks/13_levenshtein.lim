# Sum of Levenshtein distances over random word pairs.
fn rnd(s: inout [int]) -> int:
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648
    s[0] / 65536

fn word(seed: inout [int]) -> str:
    let alpha = ["a", "b", "c", "d", "e", "f"]
    join([alpha[rnd(&seed) % 6] for i in 0..10 + rnd(&seed) % 21], "")

fn lev(s: str, t: str) -> int:
    let a = split(s, "")
    let b = split(t, "")
    var prev = 0..len(b) + 1
    for i in 1..len(a) + 1:
        var cur = [i]
        for j in 1..len(b) + 1:
            var cost = 1
            if a[i - 1] == b[j - 1]:
                cost = 0
            push(cur, min(prev[j - 1] + cost, min(prev[j], cur[j - 1]) + 1))
        prev = cur
    prev[len(b)]

var seed = [31]
var total = 0
for i in 0..1500:
    let s = word(&seed)
    let t = word(&seed)
    total += lev(s, t)
print(total)
