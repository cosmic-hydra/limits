# Word frequency: top 10 words by count (ties by word).
fn rnd(s: inout [int]) -> int:
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648
    s[0] / 65536

let vocab = split("the a of to and in is it you that he was for on are with as his they be at one have this from or had by hot word", " ")
var seed = [7]
var words: [str] = []
for i in 0..300000:
    push(words, vocab[min(rnd(&seed) % len(vocab), rnd(&seed) % len(vocab))])
var ws = split(join(words, " "), " ")
sort(ws)
var uniq: [str] = []
var cnt: [int] = []
for w in ws:
    if len(uniq) > 0 and uniq[len(uniq) - 1] == w:
        cnt[len(cnt) - 1] += 1
    else:
        push(uniq, w)
        push(cnt, 1)
for k in 0..10:
    var b = 0
    for i in 1..len(uniq):
        if cnt[i] > cnt[b]:
            b = i
    print(uniq[b], cnt[b])
    cnt[b] = -1
