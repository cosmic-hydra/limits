# Tokenize statements: identifiers, numbers, operators.
fn rnd(s: [int]) -> int {
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648;
    return s[0] / 65536;
}

fn is_alpha(c: str) -> bool {
    return c >= "a" and c <= "z";
}

fn is_digit(c: str) -> bool {
    return c >= "0" and c <= "9";
}

fn main() {
    let ops = ["+", "-", "*", "/"];
    let seed = [19];
    let parts: [str] = [];
    for i in 0..20000 {
        push(parts, "v" + str(rnd(seed) % 50) + " = ");
        for j in 0..5 {
            if j > 0 {
                let sp = " ";
                if rnd(seed) % 2 == 0 {
                    sp = "";
                }
                push(parts, sp + ops[rnd(seed) % 4] + sp);
            }
            if rnd(seed) % 2 == 0 {
                push(parts, "x" + str(rnd(seed) % 100));
            } else {
                push(parts, str(rnd(seed) % 1000));
            }
        }
        push(parts, ";\n");
    }
    let cs = split(join(parts, ""), "");
    let idents = 0;
    let nums = 0;
    let opc = 0;
    let numsum = 0;
    let v7 = 0;
    let i = 0;
    while i < len(cs) {
        let c = cs[i];
        if c == " " or c == "\n" {
            i = i + 1;
        } else if is_alpha(c) {
            let t = c;
            i = i + 1;
            while i < len(cs) and (is_alpha(cs[i]) or is_digit(cs[i])) {
                t = t + cs[i];
                i = i + 1;
            }
            idents = idents + 1;
            if t == "v7" {
                v7 = v7 + 1;
            }
        } else if is_digit(c) {
            let t = c;
            i = i + 1;
            while i < len(cs) and is_digit(cs[i]) {
                t = t + cs[i];
                i = i + 1;
            }
            nums = nums + 1;
            numsum = numsum + int(t);
        } else {
            opc = opc + 1;
            i = i + 1;
        }
    }
    print(idents, nums, opc, numsum, v7);
}
