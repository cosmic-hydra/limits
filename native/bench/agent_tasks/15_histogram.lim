# Histogram with text bars.
fn rnd(s: inout [int]) -> int:
    s[0] = (s[0] * 1103515245 + 12345) % 2147483648
    s[0] / 65536

var seed = [41]
var buckets = [0 for i in 0..20]
for i in 0..500000:
    let a = rnd(&seed) % 1000
    let v = (a + rnd(&seed) % 1000) / 2
    buckets[v / 50] += 1
let most = max(buckets)
for i in 0..20:
    var bar = ""
    for k in 0..buckets[i] * 60 / most:
        bar += "#"
    print(str(i * 50) + "-" + str(i * 50 + 49), buckets[i], bar)
